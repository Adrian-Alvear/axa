#!/usr/bin/env node
// `axa`: your commander from any terminal.
//   axa            mission control in this terminal: AXA and every session, live (console/tui/)
//   axa chat       the commander as a plain Claude Code session here
//   (both start the console in the background if needed)
//   axa console    start the console if needed and open it in your browser
//   axa status     list the sessions AXA is running, what needs you first
//     --watch        live dashboard: updates every second, rings the bell when a session needs you,
//                    1-9 attaches to that session, c opens the console, q quits
//     --json         the same list as JSON, for scripts
//   axa attach <name|id>   take over a session in this terminal (Ctrl-] detaches; it keeps running)
//   axa stop       stop the console (sessions keep running in tmux; the next start shows them again)
//   axa stop --all stop the console and end every session
//   axa setup terminal   write a Windows Terminal fragment: an "AXA" profile and the theme as a scheme
//   axa statusline Claude Code statusLine command: AXA's state, cost and context in your own Claude window
// Colors only on a real terminal; NO_COLOR, TERM=dumb or --no-color turn them off.
import { readFileSync, existsSync, realpathSync, rmSync } from "node:fs";
import { dirname, join } from "node:path";
import { homedir } from "node:os";
import { fileURLToPath } from "node:url";
import { createRequire } from "node:module";
import { StringDecoder } from "node:string_decoder";
import { spawn, spawnSync } from "node:child_process";

const root = join(dirname(realpathSync(fileURLToPath(import.meta.url))), "..");
const { ensureConsole, home, port, readToken, openUrl } = await import(join(root, "console", "ensure.mjs"));
const { lookOf, byUrgency: urgent, needsYou, STATUS } = await import(join(root, "console", "look.mjs"));
const { tuiRoles } = await import(join(root, "console", "theme.mjs"));
const [cmd, ...rest] = process.argv.slice(2);
const flags = new Set(rest.filter((a) => a.startsWith("--")));
const out = process.stdout;

async function api(path) {
  const res = await fetch(`http://127.0.0.1:${port}${path}`, { headers: { host: `localhost:${port}`, cookie: `axa_token=${readToken()}` } });
  if (!res.ok) throw new Error(`console returned ${res.status}`);
  return res.json();
}

// ---------- how a session looks in the terminal: glyph + word + color, never color alone ----------
const color = out.isTTY && !process.env.NO_COLOR && process.env.TERM !== "dumb" && !flags.has("--no-color");
const utf8 = process.platform === "darwin" || /utf-?8/i.test(process.env.LC_ALL || process.env.LC_CTYPE || process.env.LANG || "");
// status looks come from console/look.mjs (the vocabulary every AXA surface shares), colors from the
// "terminal" theme's roles: the 16 basic colors, so your terminal theme applies
const ROLES = tuiRoles("terminal", "16");
const paint = (role, s) => { const code = ROLES[role] ?? role; return color && code !== "0" ? `\x1b[${code}m${s}\x1b[0m` : s; };
const byUrgency = (list) => list.slice().sort(urgent);
// control characters (escape codes in a folder name, say) never reach your terminal
const oneLine = (s) => String(s || "").replace(/[\u0000-\u001f\u007f-\u009f]+/g, " ").replace(/\s+/g, " ").trim();
const cut = (s, n) => (n <= 0 ? "" : s.length > n ? s.slice(0, Math.max(0, n - 1)) + "…" : s);
const gitText = (g) => (!g ? "" : `${utf8 ? "⎇" : "git:"} ${g.branch}${g.files ? ` ${g.files}f +${g.added} -${g.removed}` : ""}${g.ahead ? ` ↑${g.ahead}` : ""}`);
const what = (s) => oneLine(s.status === "done" ? s.last_report || "finished" : s.doing || s.last_report || (s.mode === "shell" ? "shell" : ""));
function row(s, { cols = Infinity, num } = {}) {
  const { glyph: g, ascii, word, tui: code } = lookOf(s);
  const head = `${num ? `${num} ` : ""}${utf8 ? g : ascii} ${word.padEnd(9)} `;
  const name = (s.mode === "axa" ? "AXA" : oneLine(s.name)).slice(0, 16).padEnd(17);
  const git = gitText(s.git);
  const u = s.usage ? `${fmtTok(s.usage.tokens)} tok${s.usage.over_budget ? "!" : ""}`.padEnd(10) : "";
  // cost (from `axa statusline`) and the branch's PR with its checks: "$1.24 PR #12 ✓"
  const pr = s.github?.pr, mark = { passing: utf8 ? "✓" : "ok", failing: utf8 ? "✕" : "x", pending: utf8 ? "◌" : "..." }[pr?.checks] || "";
  const extra = [s.cost?.usd != null && `$${s.cost.usd.toFixed(2)}`, pr && `PR #${pr.number}${mark ? ` ${mark}` : ""}`].filter(Boolean).join(" ");
  const tail = cut(`${name}${git ? git.padEnd(26) + " " : ""}${u}${extra ? extra + " " : ""}${what(s)}`, cols - head.length);
  // a waiting session: the prompt and its options on the next line (answer it with `axa attach`)
  const ask = s.choices ? `\n${" ".repeat(Math.min(head.length, 14))}${paint("waitSoft", "↳")} ${cut(oneLine(`${[...s.choices.question.split("\n")].reverse().find((l) => l.includes("?")) || s.choices.question.split("\n").pop()} ${s.choices.options.map((o) => `${o.n}. ${o.label}`).join("  ")}`), cols - 16)}` : "";
  return paint(code, head) + tail + ask;
}
const fmtTok = (n) => (n >= 1e6 ? `${(n / 1e6).toFixed(1)}M` : n >= 1e3 ? `${Math.round(n / 1e3)}k` : String(n));
const summaryLine = (list) => {
  const n = (st) => list.filter((s) => s.status === st).length;
  const needs = list.filter(needsYou).length, W = STATUS.waiting;
  return [needs ? paint(W.tui, `${utf8 ? W.glyph : W.ascii} ${needs} need${needs > 1 ? "" : "s"} you`) : "nothing needs you", n("working") && `${n("working")} ${STATUS.working.word}`, n("done") && `${n("done")} ${STATUS.done.word}`].filter(Boolean).join(" · ");
};

// ---------- attach: drive a session from this terminal ----------
// tmux in AXA's sessions has no prefix key (everything goes to the program), so AXA runs the tmux
// client in its own PTY and takes Ctrl-] for itself: that detaches, and the session keeps running.
async function attach(s) {
  let pty;
  try { pty = createRequire(join(root, "console", "package.json"))("node-pty"); }
  catch { console.error("Attaching needs the console's dependencies: run `axa console` once."); return false; }
  const env = { ...process.env };
  for (const k of ["TMUX", "TMUX_PANE"]) delete env[k];
  if (spawnSync("tmux", ["-L", `axa-${port}`, "has-session", "-t", `=axa-${s.id}`], { stdio: "ignore", env }).status !== 0) {
    console.error(`${oneLine(s.name)} isn't running in tmux, so it can't be attached here; open it in the console instead.`);
    return false;
  }
  out.write("\x1b[2J\x1b[H");
  const p = pty.spawn("tmux", ["-L", `axa-${port}`, "attach-session", "-t", `=axa-${s.id}`], { name: process.env.TERM || "xterm-256color", cols: out.columns || 100, rows: out.rows || 30, cwd: homedir(), env });
  return new Promise((done) => {
    const wasRaw = process.stdin.isRaw;
    process.stdin.setRawMode(true); process.stdin.resume();
    // detach only this client (by its tty), never the console's own view of the session
    const detach = () => { const r = p._pty && spawnSync("tmux", ["-L", `axa-${port}`, "detach-client", "-t", p._pty], { stdio: "ignore" }); if (!r || r.status !== 0) p.kill(); };
    const utf = new StringDecoder("utf8"); // a pasted character can arrive split across chunks
    const onIn = (d) => { if (d.includes(0x1d)) return detach(); p.write(utf.write(d)); };
    // the session's window takes this terminal's size while attached (the console re-sizes it on focus)
    const fitWindow = () => spawnSync("tmux", ["-L", `axa-${port}`, "resize-window", "-t", `=axa-${s.id}:`, "-x", String(out.columns || 100), "-y", String(out.rows || 30)], { stdio: "ignore" });
    fitWindow();
    const onResize = () => { try { p.resize(out.columns, out.rows); } catch {} fitWindow(); };
    p.onData((d) => out.write(d));
    process.stdin.on("data", onIn); out.on("resize", onResize);
    p.onExit(() => {
      process.stdin.off("data", onIn); out.off("resize", onResize);
      process.stdin.setRawMode(wasRaw);
      out.write(`\x1b[0m\r\nDetached from ${s.name}; it keeps running.\r\n`);
      done(true);
    });
  });
}
function pick(list, q) {
  if (!q) return { error: "Which session? " + (list.map((s) => `${s.name} (${s.id})`).join(", ") || "none running") };
  const l = q.toLowerCase(), named = (s) => (s.mode === "axa" ? "axa" : s.name.toLowerCase());
  for (const test of [(s) => s.id === q, (s) => named(s) === l, (s) => named(s).startsWith(l) || s.id.startsWith(q)]) {
    const hits = list.filter(test);
    if (hits.length === 1) return { s: hits[0] };
    if (hits.length > 1) return { error: `"${q}" matches ${hits.map((s) => `${s.name} (${s.id})`).join(", ")}: use the id.` };
  }
  return { error: `No session "${q}". Running: ${list.map((s) => `${s.name} (${s.id})`).join(", ") || "none"}` };
}

// ---------- the live dashboard ----------
async function watch() {
  if (!out.isTTY || !process.stdin.isTTY) { console.error("axa status --watch needs a terminal; use axa status --json in scripts."); process.exit(1); }
  let list = [], err = "", prev = null, busy = false;
  const enter = () => { out.write("\x1b[?1049h\x1b[?25l"); process.stdin.setRawMode(true); process.stdin.resume(); };
  const leave = () => { out.write("\x1b[?25h\x1b[?1049l"); try { process.stdin.setRawMode(false); } catch {} };
  const quit = (code = 0) => { leave(); process.exit(code); };
  process.on("SIGINT", () => quit()); process.on("SIGTERM", () => quit());
  process.on("uncaughtException", (e) => { leave(); console.error(e); process.exit(1); });
  function draw() {
    if (busy) return;
    const cols = out.columns || 80, rows = out.rows || 24;
    const clock = new Date().toLocaleTimeString([], { hour12: false });
    const lines = [
      `${paint("title", "AXA")}  ${summaryLine(list)}`,
      "",
      ...(err ? [paint("bad", cut(err, cols))] : list.length ? list.flatMap((s, i) => row(s, { cols, num: i < 9 ? i + 1 : " " }).split("\n")) : ["No sessions running. Start one with `axa` (the commander) or from the console."]),
    ];
    while (lines.length < rows - 1) lines.push("");
    lines.length = rows - 1;
    const keys = `${list.length ? "1-9 attach · " : ""}c console · q quit`;
    lines.push(paint("dim", cut(`${keys}   ${clock}  :${port}`, cols)));
    out.write("\x1b[H" + lines.map((l) => l + "\x1b[K").join("\r\n"));
  }
  async function tick() {
    try { list = byUrgency(await api("/api/terms")); err = ""; } catch (e) { err = `Console not reachable on port ${port} (${e.message}). Start it with: axa console`; }
    // ring the bell when a session starts needing you (not for what already did when the watch began)
    const now = new Map(list.map((s) => [s.id, s.status]));
    if (prev && !busy && list.some((s) => needsYou(s) && prev.get(s.id) !== s.status)) out.write("\x07");
    prev = now;
    draw();
  }
  process.stdin.on("data", async (k) => {
    if (busy) return;
    const key = k.toString();
    if (key === "q" || key === "\x03" || key === "\x1b") quit();
    if (key === "c") openUrl(`http://localhost:${port}/?t=${readToken()}`);
    const s = /^[1-9]$/.test(key) && list[Number(key) - 1];
    // (a failed attach leaves its message on screen for a moment before the dashboard returns)
    if (s) { busy = true; leave(); if (!(await attach(s))) await new Promise((r) => setTimeout(r, 2500)); enter(); busy = false; await tick(); }
  });
  out.on("resize", draw);
  enter();
  await tick();
  setInterval(tick, 1500);
}

if (cmd === "statusline") {
  // Runs on every Claude Code status refresh: no console start, short timeouts (console/statusline.mjs)
  const { main } = await import(join(root, "console", "statusline.mjs"));
  await main();
} else if (cmd === "console") {
  if (!(await ensureConsole())) { console.error(`Couldn't start the console; see ${join(home, "console.log")}`); process.exit(1); }
  const url = `http://localhost:${port}/?t=${readToken()}`;
  console.log(`AXA console → ${url}`);
  openUrl(url);
} else if (cmd === "status") {
  if (!(await ensureConsole())) { console.error(`Couldn't start the console; see ${join(home, "console.log")}`); process.exit(1); }
  if (flags.has("--watch")) await watch();
  else {
    const sessions = byUrgency(await api("/api/terms"));
    if (flags.has("--json")) console.log(JSON.stringify(sessions, null, 2));
    else if (!sessions.length) console.log("No sessions running.");
    else {
      console.log(summaryLine(sessions));
      for (const s of sessions) console.log(`${s.id}  ${row(s, { cols: out.isTTY ? out.columns - 10 : Infinity })}`);
    }
  }
} else if (cmd === "attach") {
  if (!process.stdin.isTTY || !out.isTTY) { console.error("axa attach needs a terminal."); process.exit(1); }
  if (!(await ensureConsole())) process.exit(1);
  const { s, error } = pick(await api("/api/terms"), rest.find((a) => !a.startsWith("--")));
  if (error) { console.error(error); process.exit(1); }
  if (!s.alive) { console.error(`${s.name} has exited.`); process.exit(1); }
  console.log(`Attaching to ${s.name} (${s.id}). Ctrl-] detaches; the session keeps running.`);
  await new Promise((r) => setTimeout(r, 400));
  process.exit((await attach(s)) ? 0 : 1);
} else if (cmd === "stop") {
  const pidFile = join(home, "console.pid");
  const all = rest.includes("--all");
  if (!existsSync(pidFile)) console.log("The console isn't running.");
  else try { process.kill(Number(readFileSync(pidFile, "utf8")), "SIGTERM"); console.log("Console stopped."); } catch { console.log("The console isn't running."); }
  if (all) {
    // Sessions live on AXA's own tmux socket: ending that server ends them all (your own tmux is untouched)
    await new Promise((r) => setTimeout(r, 300));
    spawnSync("tmux", ["-L", `axa-${port}`, "kill-server"], { stdio: "ignore" });
    rmSync(join(home, "sessions.json"), { force: true });
    console.log("All sessions ended.");
  } else console.log("Sessions keep running; `axa console` shows them again. `axa stop --all` ends them too.");
} else if (cmd === "setup" && rest[0] === "terminal") {
  // A Windows Terminal profile for AXA plus the current theme as a color scheme, as a JSON fragment
  // (console/wtfragment.mjs). Only written when you run this; --print shows it without writing.
  const wt = await import(join(root, "console", "wtfragment.mjs"));
  const { settingsFile } = await import(join(root, "console", "tui", "settings.mjs"));
  const { DEFAULTS } = await import(join(root, "console", "tui", "theme.mjs"));
  const themeArg = rest.find((a) => a.startsWith("--theme="))?.slice(8);
  const theme = themeArg || settingsFile(join(home, "ui.json"), DEFAULTS).cfg.theme;
  const frag = wt.fragment({ theme, commandline: wt.wslCommandline({ distro: process.env.WSL_DISTRO_NAME, node: process.execPath, axa: join(root, "bin", "axa") }) });
  if (flags.has("--print")) { console.log(JSON.stringify(frag, null, 2)); process.exit(0); }
  const dir = wt.fragmentsDir(process.env);
  if (!dir) { console.error("Couldn't find Windows Terminal's fragments folder (this works from WSL or Windows). Set AXA_WT_FRAGMENTS to a folder, or use --print and save the JSON yourself."); process.exit(1); }
  const file = wt.writeFragment(dir, frag);
  console.log(`Wrote ${file}\n  profile "AXA" (${frag.profiles[0].commandline})\n  color scheme "${frag.schemes[0].name}"\nRestart Windows Terminal; AXA shows up in its new-tab menu. Delete that folder to remove it.`);
} else if (!cmd || cmd === "ui") {
  // Mission control in this terminal: AXA and every session, live (console/tui/)
  if (!process.stdin.isTTY || !out.isTTY) { console.error("`axa` opens a full-screen UI and needs a terminal. In scripts use: axa status --json"); process.exit(1); }
  if (!(await ensureConsole())) { console.error(`Couldn't start the console; see ${join(home, "console.log")}`); process.exit(1); }
  const { runTui } = await import(join(root, "console", "tui", "index.mjs"));
  await runTui({ port, readToken, openUrl, root, home });
} else if (cmd === "chat" || cmd.startsWith("-")) {
  // The commander as a plain Claude Code session in this terminal (what `axa` used to open)
  await ensureConsole();
  const env = { ...process.env, AXA_ROLE: "commander" };
  const args = ["--plugin-dir", root, "--append-system-prompt-file", join(root, "commander.md"), ...process.argv.slice(cmd === "chat" ? 3 : 2)];
  const child = spawn("claude", args, { stdio: "inherit", env });
  child.on("exit", (code) => process.exit(code ?? 0));
} else {
  console.log(`Usage:
  axa                      mission control: AXA and every session, live, in this terminal (Ctrl-b ? for keys)
  axa chat                 the commander as a plain Claude Code session in this terminal
  axa console              open the console in your browser
  axa status [--watch|--json]   sessions, what needs you first (--watch: live, 1-9 attach, q quit)
  axa attach <name|id>     take over a session here (Ctrl-] detaches; it keeps running)
  axa stop [--all]         stop the console (--all also ends every session)
  axa setup terminal [--print] [--theme=<id>]   add an AXA profile and color scheme to Windows Terminal
  axa statusline           Claude Code statusLine command (see the README to install it)`);
}
