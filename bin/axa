#!/usr/bin/env node
// axa: the AXA hub in your terminal, and a few commands around it.
import { readFileSync, realpathSync } from "node:fs";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { spawn } from "node:child_process";

const root = join(dirname(realpathSync(fileURLToPath(import.meta.url))), "..");
const { files, openUrl, webUrl } = await import(join(root, "src", "paths.mjs"));
const { api, ensureDaemon, stopDaemon } = await import(join(root, "src", "daemon.mjs"));
const [cmd = "hub", ...rest] = process.argv.slice(2);
const flags = new Set(rest.filter((a) => a.startsWith("--")));
const out = process.stdout;

const USAGE = `AXA: one place for all your Claude Code sessions, chats and agents.

  axa                  the hub: running sessions, past chats, agents, projects (? inside for keys)
  axa chat             talk to the AXA commander here, as a plain Claude Code session
  axa web              open the web console in your browser
  axa status [--json]  what's running, what needs you first
  axa projects [--json] [--fresh]   every project in progress: git, sessions, last review, the handoff's next steps
  axa attach <name>    take over one session in this terminal (Ctrl-] detaches; it keeps running)
  axa review [path] [--base <sha>]   a milestone review of a repo's recent work (base..HEAD + uncommitted)
  axa review --reset-milestone [path]   forget that repo+branch's stored milestone (the next review's base)
  axa stop [--all]     stop the background daemon (--all also ends every session)
  axa restart          restart the daemon (sessions keep running)
  axa notify [live|digest|quiet]   interruptions: as they happen, only one-way doors + failures (a digest
                       for the rest), or none
  axa approver test "<command>"   what AXA's policy and approver rules would do with a command (a dry run)
  axa queue [--json]   finished work waiting for review: commits, diff size, checks, reviewer verdict, ready to land
  axa usage [--json]   tokens (official) and cost (estimate) per session and per project per day, the 5-hour /
                       weekly limits
  axa whatsup          what every session is doing now, in a few sentences (spoken when the voice is on)
  axa brief [HH:MM|off|now]   the daily brief: show it, set its time, turn it off, or get one right away
  axa trust <path>     trust a project (its git repo root) for Claude Code, so sessions AXA starts there
                       don't stop on the folder-trust prompt. Your decision: only you run it, never a session
  axa voice install kokoro [--yes]    a better, offline neural voice (~380 MB); uninstall kokoro removes it
  axa voice status     the voice engine, whether Kokoro is installed, its test timing`;

async function daemon() {
  if (await ensureDaemon()) return;
  console.error(`AXA couldn't start its background daemon; see ${files.daemonLog}`);
  process.exit(1);
}
const needTty = (what) => { if (!process.stdin.isTTY || !out.isTTY) { console.error(`${what} needs a terminal. In scripts use: axa status --json`); process.exit(1); } };

// ---------- status ----------
const color = out.isTTY && !process.env.NO_COLOR && process.env.TERM !== "dumb";
const paint = (c, s) => (color ? `\x1b[${c}m${s}\x1b[0m` : s);
const LOOK = { waiting: ["⚠", "needs you", "1;33"], needs_trust: ["⚠", "needs trust", "1;33"], stuck: ["◷", "stuck", "31"], working: ["●", "working", "36"], limited: ["⏸", "limited", "33"], failed: ["✗", "failed", "31"], done: ["✓", "done", "32"], ready: ["○", "ready", "0"], starting: ["◌", "starting", "2"], exited: ["–", "exited", "2"] };
const ORDER = Object.keys(LOOK);
const one = (s) => String(s || "").replace(/[\u0000-\u001f\u007f-\u009f]+/g, " ").replace(/\s+/g, " ").trim();
async function status() {
  const list = (await api("/api/terms")).sort((a, b) => ORDER.indexOf(a.status) - ORDER.indexOf(b.status));
  if (flags.has("--json")) return console.log(JSON.stringify(list, null, 2));
  if (!list.length) return console.log("Nothing running. `axa` opens the hub.");
  for (const s of list) {
    const [g, word, c] = LOOK[s.status] || ["?", s.status, "0"];
    const name = (s.mode === "axa" ? "AXA commander" : one(s.name)).padEnd(20);
    const said = one(s.status === "needs_trust" ? s.hint : s.status === "waiting" && s.choices ? s.choices.question.split("\n").pop() : s.status === "done" ? s.last_report : s.status === "limited" ? `usage limit${s.limit_resets ? `, resets ${s.limit_resets}` : ""}` : s.status === "failed" ? s.error : s.doing);
    console.log(`${s.id}  ${paint(c, `${g} ${word.padEnd(9)}`)} ${name} ${said.slice(0, Math.max(10, (out.columns || 120) - 46))}`);
  }
}

// ---------- attach: drive one session from this terminal ----------
async function attach(q) {
  const { createRequire } = await import("node:module");
  const { SOCKET, tmuxEnv } = await import(join(root, "src", "core", "tmux-client.mjs"));
  const pty = createRequire(join(root, "package.json"))("node-pty");
  const list = await api("/api/terms");
  const name = (s) => (s.mode === "axa" ? "axa" : s.name.toLowerCase());
  const l = (q || "").toLowerCase();
  const hits = [(s) => s.id === q, (s) => name(s) === l, (s) => name(s).startsWith(l) || s.id.startsWith(q)].map((t) => list.filter(t)).find((h) => h.length);
  if (!q || !hits || hits.length > 1) { console.error(`${!q ? "Which session?" : hits ? `"${q}" matches several:` : `No session "${q}".`} Running: ${list.map((s) => `${name(s)} (${s.id})`).join(", ") || "none"}`); process.exit(1); }
  const s = hits[0];
  console.log(`Attaching to ${s.mode === "axa" ? "the AXA commander" : s.name}. Ctrl-] detaches; it keeps running.`);
  await new Promise((r) => setTimeout(r, 300));
  const env = tmuxEnv();
  const p = pty.spawn("tmux", ["-L", SOCKET, "attach-session", "-t", `=axa-${s.id}`], { name: process.env.TERM || "xterm-256color", cols: out.columns || 100, rows: out.rows || 30, env });
  const { spawnSync } = await import("node:child_process");
  const fit = () => spawnSync("tmux", ["-L", SOCKET, "resize-window", "-t", `=axa-${s.id}:`, "-x", String(out.columns || 100), "-y", String(out.rows || 30)], { stdio: "ignore", env });
  fit();
  process.stdin.setRawMode(true); process.stdin.resume();
  process.stdin.on("data", (d) => { if (d.includes(0x1d)) { spawnSync("tmux", ["-L", SOCKET, "detach-client", "-t", p._pty], { stdio: "ignore", env }); return; } p.write(d.toString("utf8")); });
  out.on("resize", () => { try { p.resize(out.columns, out.rows); } catch {} fit(); });
  p.onData((d) => out.write(d));
  p.onExit(() => { process.stdin.setRawMode(false); out.write("\x1b[0m\r\nDetached; the session keeps running.\r\n"); process.exit(0); });
}

// ---------- review: a milestone review, with its progress, through the daemon ----------
async function review() {
  const args = [...rest];
  let base;
  const b = args.indexOf("--base");
  if (b >= 0) { base = args[b + 1]; if (!base || base.startsWith("--")) { console.error("--base needs a commit"); process.exit(1); } args.splice(b, 2); }
  const cwd = resolve(args.find((a) => !a.startsWith("--")) || process.cwd());
  let r;
  try { r = await api("/api/review", { method: "POST", body: { cwd, base, source: "cli" } }); }
  catch (e) { console.error(`axa review: ${e.message}`); process.exit(1); }
  console.log(`${r.already ? "Already running" : "Milestone review"} [${r.id}] ${r.repo} (${r.branch}) ${String(r.base).slice(0, 12)}..HEAD · base: ${r.base_why}`);
  let last = "";
  for (;;) {
    const now = `${r.state} ${r.round} ${r.progress}`;
    if (now !== last) {
      last = now;
      const what = r.state === "reviewing" ? `${r.round ? `re-review ${r.round}/${r.max_rounds}` : "reviewing"}… (${r.progress})` : ["fixer-starting", "fixing"].includes(r.state) ? `fix round ${r.round}/${r.max_rounds}: ${r.progress}` : null;
      if (what) console.log(`  ${new Date().toLocaleTimeString([], { hour12: false })}  ${one(what)}`);
    }
    if (["done", "failed"].includes(r.state)) break;
    await new Promise((ok) => setTimeout(ok, 2000));
    try { r = await api(`/api/review/${r.id}`); } catch (e) { console.error(`axa review: lost the daemon (${e.message})`); process.exit(1); }
  }
  console.log(one(r.line || r.state));
  for (const c of r.checks || []) console.log(`  ${c.ok ? "pass" : "FAIL"}: ${one(c.cmd)}`);
  for (const [i, f] of (r.findings || []).entries()) console.log(`  ${i + 1}. [${f.severity}] ${f.file}:${f.line} ${one(f.problem)}\n     evidence: ${one(f.evidence)}`);
  process.exit(r.verdict === "approve" || r.verdict === "warn" ? 0 : 1);
}

// the stored milestone is read on every review, so this needs no daemon
async function resetMilestone() {
  const { forgetMilestone } = await import(join(root, "src", "core", "milestone.mjs"));
  const cwd = resolve(rest.find((a) => !a.startsWith("--")) || process.cwd());
  try {
    const { key, removed } = forgetMilestone(cwd);
    console.log(removed ? `Forgot the milestone of ${key} (${removed.verdict} at ${String(removed.sha).slice(0, 12)}); the next review picks its base afresh.` : `No milestone stored for ${key}.`);
  } catch (e) { console.error(`axa review: ${e.message}`); process.exit(1); }
}

switch (cmd) {
  case "hub": case "ui": {
    needTty("The hub");
    await daemon();
    const { runTui } = await import(join(root, "src", "tui", "app.mjs"));
    await runTui();
    break;
  }
  case "chat": {
    // the commander as a plain Claude Code session in this terminal
    await daemon();
    const child = spawn("claude", ["--plugin-dir", root, "--append-system-prompt-file", join(root, "commander.md"), ...rest], { stdio: "inherit", env: { ...process.env, AXA_ROLE: "commander" } });
    child.on("exit", (code) => process.exit(code ?? 0));
    break;
  }
  case "web": case "console":
    await daemon();
    console.log(`AXA web console → ${webUrl()}\n(the link holds your access token: keep it to yourself)`);
    openUrl(webUrl());
    break;
  case "status": await daemon(); await status(); break;
  case "review":
    if (flags.has("--reset-milestone")) { await resetMilestone(); break; }
    await daemon(); await review(); break;
  case "attach": needTty("axa attach"); await daemon(); await attach(rest.find((a) => !a.startsWith("--"))); break;
  case "stop": {
    const all = flags.has("--all");
    console.log((await stopDaemon({ all })) ? "AXA daemon stopped." : "The AXA daemon wasn't running.");
    console.log(all ? "All sessions ended." : "Sessions keep running; `axa` shows them again (`axa stop --all` ends them).");
    break;
  }
  case "restart":
    await stopDaemon();
    await new Promise((r) => setTimeout(r, 500));
    await daemon();
    console.log("AXA daemon restarted; sessions kept running.");
    break;
  case "projects": {
    // every project in progress (the same summary the commander's review_projects gives)
    await daemon();
    const { projectsText } = await import(join(root, "src", "core", "projects.mjs"));
    try {
      const list = await api(`/api/projects${flags.has("--fresh") ? "?fresh=1" : ""}`);
      console.log(flags.has("--json") ? JSON.stringify(list, null, 2) : projectsText(list).replace(/[\u0000-\u0008\u000b-\u001f\u007f-\u009f]/g, ""));
    } catch (e) { console.error(`axa projects: ${e.message}`); process.exit(1); }
    break;
  }
  case "notify": {
    // interruptions: live (as it happens) | digest (only one-way doors and failures interrupt; the rest every N min)
    // | quiet (nothing interrupts). No argument: show it.
    const { notifySettings, writeNotifyMode } = await import(join(root, "src", "core", "notify.mjs"));
    const arg = rest.find((a) => !a.startsWith("--"));
    if (arg === undefined) { const st = notifySettings(); console.log(`Interruptions: ${st.mode}${st.mode === "digest" ? ` (a digest every ${st.digestMin} min)` : ""}. Set with: axa notify live | digest | quiet`); break; }
    try { writeNotifyMode(files.ui, arg); } catch (e) { console.error(`axa notify: ${e.message}`); process.exit(1); }
    console.log(`Interruptions: ${arg}.${arg === "digest" ? " Only one-way doors and failures interrupt; the rest is said as a digest (w says it now)." : arg === "quiet" ? " Nothing interrupts; w says what's up." : ""}`);
    break;
  }
  case "approver": {
    // `axa approver test "<command>"`: what AXA's policy and approver rules would do with it, without running it
    // or asking the model
    const sub = rest[0], command = rest.slice(1).join(" ");
    if (sub !== "test" || !command) { console.error('usage: axa approver test "<command>" [--commander]'); process.exit(1); }
    const { dryRun } = await import(join(root, "hooks", "approver.mjs"));
    const r = dryRun(command, { cwd: process.cwd(), role: flags.has("--commander") ? "commander" : "worker" });
    if (r.chain.parts.length > 1 || r.chain.writes.length) console.log(`parts: ${r.chain.parts.map((p, i) => `(${i + 1}) ${p}`).join("  ")}${r.chain.writes.length ? `  · writes ${r.chain.writes.join(", ")}` : ""}`);
    for (const st of r.steps) console.log(`  ${st}`);
    console.log({ allow: "ALLOW", deny: "DENY", ask: "ASK THE USER", model: "THE MODEL DECIDES" }[r.decision] + `: ${r.reason}${r.instead ? `\n  instead: ${r.instead}` : ""}`);
    break;
  }
  case "queue": {
    // finished work waiting for review: unlanded commits, diff size, checks, reviewer verdict, ready to land
    await daemon();
    const q = await api("/api/queue");
    if (flags.has("--json")) { console.log(JSON.stringify(q, null, 2)); break; }
    console.log(q.text);
    if (q.waiting.length) console.log(`Queued behind the worker cap (${q.max_working} at most): ${q.waiting.map((w) => w.id).join(", ")}`);
    break;
  }
  case "usage": {
    // per session (tokens: official, from Claude Code's transcripts; cost: an estimate), per project per day,
    // and the account's 5-hour / weekly limits when Claude Code's status line has them
    await daemon();
    const u = await api("/api/usage");
    if (flags.has("--json")) { console.log(JSON.stringify(u, null, 2)); break; }
    const { usd } = await import(join(root, "src", "core", "usage.mjs"));
    const k = (n) => (n >= 1e6 ? `${(n / 1e6).toFixed(1)}M` : `${Math.round(n / 1e3)}k`);
    console.log(`Limits (official): ${u.limits_text || "unknown (needs a status line that saves its input)"}`);
    console.log(`Sessions: ${usd(u.total_cost)} in all (estimate)`);
    for (const s of [...u.sessions].sort((a, b) => (b.cost || 0) - (a.cost || 0))) console.log(`  ${s.name.padEnd(20)} ${k(s.tokens).padStart(7)} tokens  ${usd(s.cost).padStart(7)}  ${s.model || ""}${s.over_budget ? "  OVER BUDGET" : ""}`);
    const days = Object.entries(u.projects).flatMap(([p, ds]) => Object.entries(ds).map(([d, r]) => ({ p, d, ...r }))).sort((a, b) => b.d.localeCompare(a.d) || b.cost - a.cost).slice(0, 14);
    if (days.length) { console.log("Per project per day (estimate):"); for (const r of days) console.log(`  ${r.d}  ${r.p.padEnd(20)} ${k(r.tokens).padStart(7)} tokens  ${usd(r.cost).padStart(7)}`); }
    break;
  }
  case "whatsup": {
    // every session's state in 1-3 sentences; the daemon also says it when the voice is on
    await daemon();
    try { const r = await api("/api/whatsup", { method: "POST" }); console.log(r.text); }
    catch (e) { console.error(`axa whatsup: ${e.message}`); process.exit(1); }
    break;
  }
  case "brief": {
    // the daily brief: show the setting, set it (HH:MM or off; in ui.json, every other setting kept), or send one now
    const { BRIEF_TIMES, parseBriefArg, writeBriefAt } = await import(join(root, "src", "core", "projects.mjs"));
    const arg = rest.find((a) => !a.startsWith("--"));
    let cfg = {};
    try { cfg = JSON.parse(readFileSync(files.ui, "utf8")); } catch {}
    if (arg === undefined) {
      const at = cfg.notify?.brief_at;
      console.log(at ? `Daily brief: every day at ${at} (one notification on all projects; spoken when the voice is on).` : "Daily brief: off.");
      console.log(`Set it with: axa brief HH:MM (e.g. ${BRIEF_TIMES.slice(1).join(", ")}) · axa brief off · axa brief now (one right away)`);
      break;
    }
    let v;
    try { v = parseBriefArg(arg); } catch (e) { console.error(`axa brief: ${e.message}`); process.exit(1); }
    if (v === "now") {
      await daemon();
      try {
        const n = await api("/api/brief", { method: "POST" });
        if (n.error) { console.error(`axa brief: ${n.error}`); process.exit(1); }
        console.log(`${n.title}: ${n.body}`);
      } catch (e) { console.error(`axa brief: ${e.message}`); process.exit(1); }
      break;
    }
    try { writeBriefAt(files.ui, v); } catch (e) { console.error(`axa brief: ${e.message}`); process.exit(1); }
    console.log(v ? `Daily brief at ${v}. If that time has already passed today, the first one comes tomorrow (axa brief now sends one at once).` : "Daily brief off.");
    break;
  }
  case "trust": {
    // changes Claude Code's own config file only; needs no daemon
    const { trustProject } = await import(join(root, "src", "core", "trust.mjs"));
    const path = rest.find((a) => !a.startsWith("--"));
    if (!path) { console.error("Usage: axa trust <project folder>"); process.exit(1); }
    try {
      const r = trustProject(path);
      console.log(r.changed
        ? `Trusted ${r.root}: set projects["${r.root}"].hasTrustDialogAccepted = true in ${r.file} (it was ${r.before === undefined ? "unset" : JSON.stringify(r.before)}).`
        : `${r.root} was already trusted in ${r.file}; nothing changed.`);
    } catch (e) { console.error(`axa trust: ${e.message}`); process.exit(1); }
    break;
  }
  case "voice": {
    const { main } = await import(join(root, "src", "core", "kokoro-install.mjs"));
    process.exit(await main(rest));
  }
  case "help": case "--help": case "-h": console.log(USAGE); break;
  default: console.log(USAGE); process.exit(1);
}
